# API Keys for Language Model Providers
# Copy this file to .env and add your actual API keys

# OpenAI (GPT models)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (Claude models) 
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# ElevenLabs (Speech Synthesis)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Optional: Default pitch analysis backend
PROSODIC_PITCH_BACKEND=aubio

# Logging Configuration
# Log directory path (defaults to ./log)
PROSODIC_LOG_DIR=./log

# Log level (DEBUG, INFO, WARN, ERROR, FATAL - defaults to INFO)
PROSODIC_LOG_LEVEL=INFO

# Maximum log file size in bytes (defaults to 6MB)
PROSODIC_LOG_MAX_SIZE=6145728

# Maximum number of log files to keep for rotation (defaults to 10)
PROSODIC_LOG_MAX_FILES=10